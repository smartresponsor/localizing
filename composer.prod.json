{
  "name": "localizing/locale",
  "type": "library",
  "description": "Localizing process app",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-intl": "*",
    "collectioning/collection": "dev-main || dev-master",
    "cruding/crud": "dev-master",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-backend-table-actions || dev-backend-table-metadata || dev-initial-platform-primitive || dev-main || dev-master",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/intl": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/translation": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "viewing/view": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Localizing\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "require-dev": {
    "gating/gate": "dev-master"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ]
}
