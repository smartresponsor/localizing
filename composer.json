{
  "name": "localizing/locale",
  "type": "library",
  "description": "Localizing process app",
  "license": "PolyForm-Noncommercial-1.0.0",
  "require": {
    "php": ">=8.4",
    "ext-intl": "*",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-master",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/intl": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/translation": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "symfony/panther": "^2.0",
    "symfony/test-pack": "^1.2",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Localizing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Localizing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check:syntax": "@php bin/lint-php.php",
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": "phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "test:behavioral-coverage": "@php bin/generate-behavioral-ui-coverage.php",
    "doctrine:schema:validate": "@php bin/console doctrine:schema:validate --skip-sync --env=test",
    "doctrine:schema:parity": [
      "@doctrine:schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "localizing:audit": "@php bin/console localizing:audit-catalogs",
    "localizing:export": "@php bin/console localizing:export-catalogs",
    "quality": [
      "@check:syntax",
      "@cs:check",
      "@phpstan",
      "@test",
      "@localizing:audit",
      "@doctrine:schema:parity",
      "@test:behavioral-coverage",
      "@gate"
    ],
    "gate": "@php vendor/bin/gating check --target=."
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ]
}
