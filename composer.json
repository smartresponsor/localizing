{
  "name": "localizing/locale",
  "type": "library",
  "description": "Localizing process app",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-intl": "*",
    "cruding/crud": "dev-master",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "doctrine/orm": "^3.3",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/console": "^8.1",
    "symfony/dotenv": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/intl": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/translation": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/yaml": "^8.1",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Localizing\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Localizing\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check:syntax": "@php bin/lint-php.php",
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": "phpunit",
    "gating": "@php ../Gating/bin/gating check --target=. --policy-root=../Gating/.gating --severity-config=../Gating/.gating/config/severity.yaml",
    "doctrine:schema:validate": "@php bin/console doctrine:schema:validate --skip-sync --env=test",
    "doctrine:schema:parity": [
      "@doctrine:schema:validate",
      "@php bin/console doctrine:migrations:up-to-date --env=test"
    ],
    "localizing:audit": "@php bin/console localizing:audit-catalogs",
    "localizing:export": "@php bin/console localizing:export-catalogs",
    "quality": [
      "@check:syntax",
      "@cs:check",
      "@phpstan",
      "@test",
      "@localizing:audit",
      "@doctrine:schema:parity",
      "@gating"
    ]
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true
      }
    }
  ]
}
